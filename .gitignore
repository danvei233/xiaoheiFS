# ============================================
# Private keys / keystores / certificates
# ============================================
# Private-key material, keystores and certificates must never be committed
# (mirrors the .dockerignore P0-24 contract). Test fixtures that must stay
# tracked should be allowlisted explicitly with "!..." below.
*.key
*.pem
*.jks
*.p12
*.pfx
*.crt
*.keystore


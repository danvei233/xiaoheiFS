<?xml version="1.0" encoding="utf-8"?>
<!-- 生产/默认构建：禁止明文 HTTP（cleartext）。
     自托管实例必须使用 HTTPS；开发联调用 debug 变体覆盖本文件。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
